# Set either key. OpenRouter takes precedence when both are configured.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# optional, defaults to claude-opus-5-5
ATLAS_MODEL=
# optional, model for the second-model meaning check
ATLAS_CHECKER_MODEL=
# optional, anonymous feedback counts (Neon Postgres) and the token that signs feedback
DATABASE_URL=
FEEDBACK_SECRET=
# optional, natural read-aloud voice; without it the page uses the phone's voice
ELEVENLABS_API_KEY=
# optional, "ATLAS calls you" (Vonage Voice). Off unless all four are set, plus DATABASE_URL and FEEDBACK_SECRET.
ATLAS_VONAGE_APPLICATION_ID=
# the application's private key: a PEM, or the PEM base64-encoded
ATLAS_VONAGE_PRIVATE_KEY=
# the caller-id number linked to the application, E.164 (+1...)
ATLAS_VONAGE_FROM_NUMBER=
# seals phone numbers and plan text (AES-GCM) and signs the callback URLs; at least 32 random characters,
# e.g. `openssl rand -base64 32` (calls stay off with a shorter or placeholder value)
ATLAS_CALL_SECRET=
# optional, calls the whole site may place per UTC day (default 40)
ATLAS_CALL_DAILY_CAP=
# optional, the https origin Vonage calls back; defaults to the production domain, or the preview's own URL
ATLAS_PUBLIC_URL=
# recommended, the Vonage account's webhook signature secret (dashboard, API Settings, Signed Webhooks on). When set,
# every call callback must carry a valid Vonage HS256 signature; when unset, callbacks are bound only by the signed
# ticket in their URL and the call UUID checked against Vonage's own GET /v1/calls/{uuid} (an accepted trade-off)
ATLAS_VONAGE_SIGNATURE_SECRET=
# optional, "Say your answer" in the teach-back quiz (Deepgram speech-to-text). Also needs FEEDBACK_SECRET.
# Without it, on Vercel the AI Gateway (OIDC) is used instead. ATLAS_STT_DISABLED=1 turns speaking answers off.
# On Vercel it also needs DATABASE_URL with migration 005_stt_usage.sql applied (shared budget); otherwise no mic shows.
DEEPGRAM_API_KEY=
# required with DATABASE_URL for "Say your answer": the hourly sweep cron (vercel.json) authenticates with it and
# deletes usage counters older than two days. Without it the feature stays off, so no counters are written at all.
CRON_SECRET=
